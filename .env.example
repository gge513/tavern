# Postgres (Neon or any managed Postgres). Tables live in the `reprise` schema.
DATABASE_URL=

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=

# GitHub OAuth app (callback: https://<your-deploy>/api/auth/callback/github).
# Optional in the sense that email+password signup works without it, but the
# generated-profile flow is much better with GitHub identity.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Optional: raises GitHub API rate limits for public-profile analysis.
# Public data only — the app never requests private repository access.
GITHUB_PAT=

# Anthropic API key — powers profile drafts, match explanations, and the
# bartender. Without it the app degrades to template text (everything still
# works; it's just less charming).
ANTHROPIC_API_KEY=
